{
  "info": {
    "name": "Craigslist Upgrade - Laravel Sanctum Lab",
    "description": "Postman collection for the instructor's Laravel Sanctum token authentication laboratory. Fill collection variables before running requests. Do not commit real credentials or tokens.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Register - Success",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"{{test_name}}\",\n  \"email\": \"{{test_email}}\",\n  \"password\": \"{{test_password}}\",\n  \"password_confirmation\": \"{{test_password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/register",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "register"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Registration returns 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('Registration message is correct', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.message).to.eql('Registration successful');",
              "});",
              "",
              "pm.test('Returned user email matches test_email', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.user.email).to.eql(pm.collectionVariables.get('test_email'));",
              "});",
              "",
              "pm.test('Password and remember token are not exposed', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.user).to.not.have.property('password');",
              "    pm.expect(json.user).to.not.have.property('remember_token');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
